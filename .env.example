# Telegram
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Local monitor
CHECK_INTERVAL_MINUTES=15
MIN_MATCH_SCORE=60

# Vercel Gmail OAuth
# Paste the complete JSON content of token.json into this variable.
GMAIL_TOKEN_JSON={"token":"...","refresh_token":"...","token_uri":"https://oauth2.googleapis.com/token","client_id":"...","client_secret":"...","scopes":["https://www.googleapis.com/auth/gmail.readonly"]}

# Optional OAuth client JSON.
GMAIL_CREDENTIALS_JSON={"installed":{"client_id":"...","project_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","client_secret":"...","redirect_uris":["http://localhost"]}}
